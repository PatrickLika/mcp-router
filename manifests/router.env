# Non-secret settings. Secrets go in the mcp-router-secrets Secret (README).

# The public HTTPS address Claude connects to. Must match the tunnel hostname
# exactly: it is baked into the OAuth metadata Claude reads.
ROUTER_BASE_URL=https://mcp.likasolutions.com

# GitHub accounts allowed to sign in, comma-separated. Anyone else completes
# GitHub's login and is then refused by the router.
ALLOWED_GITHUB_LOGINS=PatrickLika

LOG_LEVEL=INFO
